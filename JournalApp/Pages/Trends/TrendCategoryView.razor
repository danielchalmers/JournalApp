@namespace JournalApp
@using System.Globalization
@implements IDisposable
@inject PreferenceService PreferenceService

@if (Category.Type is PointType.Text or PointType.Note)
{
    <div class="trend-view trend-view-notes">
        @foreach (var (day, points) in PointsByDay)
        {
            foreach (var point in points.Where(x => !string.IsNullOrEmpty(x.Text)))
            {
                <MudTextField Class="trend-view-note" Value="point.Text" Typo="Typo.body2"
                              Label="@GetNoteLabel(point, day)"
                              ReadOnly Underline="false" Sizing="InputSizing.Auto" />
            }
        }
    </div>
}
else
{
    <div class="trend-view trend-view-chart">
        <MudChart T="decimal"
                  ChartType="ChartType.Line"
                  ChartSeries="_series"
                  ChartLabels="_labels"
                  ChartOptions="_options"
                  Width="100%"
                  Height="100%"
                  MatchBoundsToSize>
            <TooltipTemplate>
                <MudBlazor.Charts.ChartTooltip Title="@TooltipValue(context.Segment)" Subtitle="@context.Segment.LabelXValue" Color="@context.Color" X="0" Y="0" />
            </TooltipTemplate>
        </MudChart>
    </div>
}

@code {
    // How many x-axis labels a chart can show before M/d dates start colliding at phone width.
    const int MaxDateLabels = 6;

    // How many horizontal gridlines to aim for when the value range isn't a known scale.
    const int TargetValueTicks = 4;

    List<ChartSeries<decimal>> _series = [];
    string[] _labels = [];
    LineChartOptions _options = new();

    [Parameter]
    public DataPointCategory Category { get; set; }

    [Parameter]
    public IReadOnlyList<DateOnly> Dates { get; set; }

    [Parameter]
    public IReadOnlyDictionary<DateOnly, IReadOnlyCollection<DataPoint>> PointsByDay { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        PreferenceService.ThemeChanged += OnThemeChanged;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        BuildChart();
    }

    void BuildChart()
    {
        var points = PointsByDay
            .Select(x => new TrendChartPoint(x.Key, x.Value.LastOrDefault()))
            .ToList();

        var values = points.Select(GetValue).ToList();

        // Every point carries its date so tooltips can show it; the axis only draws every nth one.
        _labels = [.. points.Select(p => p.DayLabel)];

        _series = [new ChartSeries<decimal> { Data = values }];
        _options = BuildOptions(values, Math.Max(1, (int)Math.Ceiling(points.Count / (double)MaxDateLabels)));
    }

    decimal? GetValue(TrendChartPoint point) => Category.Type switch
    {
        PointType.Mood => point.Mood,
        PointType.Sleep => point.SleepHours,
        PointType.Scale or PointType.LowToHigh or PointType.MildToSevere => point.Scale,
        PointType.Bool => point.Bool,
        PointType.Medication => point.MedDose,
        PointType.Number => point.Number,
        _ => null,
    };

    LineChartOptions BuildOptions(IReadOnlyList<decimal?> values, int labelInterval)
    {
        var options = new LineChartOptions
        {
            // Every chart plots one series, and the category name is already the header above it.
            ShowLegend = false,
            // A day with no neighbours has no line segment to draw, so the marker is the only thing that shows it.
            ShowDataMarkers = true,
            ShowToolTips = true,
            // M/d dates collide at phone width, so the axis is thinned without taking the dates out of the tooltips.
            XAxisLabelInterval = labelInterval,
            // Readings are a value per day, not a continuous signal, so don't curve between them.
            InterpolationOption = InterpolationOption.Straight,
            LineStrokeWidth = 3,
            YAxisLines = true,
            XAxisLines = false,
            // The chart writes colors straight into SVG attributes, where CSS variables don't resolve,
            // so this has to be the literal hex of the theme primary for the active mode.
            ChartPalette = [PreferenceService.PrimaryColor],
        };

        ConfigureYAxis(options, values);

        return options;
    }

    void ConfigureYAxis(LineChartOptions options, IReadOnlyList<decimal?> values)
    {
        switch (Category.Type)
        {
            case PointType.Mood:
                // One line per emoji, labelled with the emoji itself so the scale explains itself.
                options.YAxisTicks = 1;
                options.MaxNumYAxisTicks = TrendChartPoint.ChartEmojis.Count;
                options.YAxisToStringFunc = MoodLabel;
                break;

            case PointType.Bool:
                // Anchor to zero so "No" is always on the axis even in a month that's all yes.
                options.YAxisTicks = 1;
                options.MaxNumYAxisTicks = 2;
                options.YAxisRequireZeroPoint = true;
                options.YAxisSuggestedMax = 1;
                options.YAxisToStringFunc = v => v >= 0.5 ? "Yes" : "No";
                break;

            case PointType.Scale:
            case PointType.LowToHigh:
            case PointType.MildToSevere:
                options.YAxisTicks = 1;
                options.MaxNumYAxisTicks = 6;
                options.YAxisFormat = "0";
                break;

            case PointType.Sleep:
                options.YAxisTicks = NiceStep(values, TargetValueTicks, out _);
                options.YAxisToStringFunc = v => $"{v:0.#}h";
                break;

            default:
                options.YAxisTicks = NiceStep(values, TargetValueTicks, out var isFlat);
                // A series that never changes sits on a single gridline, which lands it on the axis itself;
                // stretching the axis down to zero puts the line back inside the chart.
                options.YAxisRequireZeroPoint = isFlat;
                options.YAxisFormat = "0.##";
                break;
        }
    }

    /// <summary>
    /// Picks a 1/2/5/10 gridline step that covers the values in roughly <paramref name="targetTicks"/> lines.
    /// </summary>
    static int NiceStep(IReadOnlyList<decimal?> values, int targetTicks, out bool isFlat)
    {
        var present = values.Where(v => v.HasValue).Select(v => v.Value).ToList();
        isFlat = false;

        if (present.Count == 0)
            return 1;

        var min = present.Min();
        var max = present.Max();
        var range = (double)(max - min);

        if (range <= 0)
        {
            // Every reading is the same, so size the axis against the value itself instead of the range.
            isFlat = true;
            range = Math.Abs((double)max);
        }

        if (range <= 0)
            return 1;

        var rough = range / targetTicks;
        var magnitude = Math.Pow(10, Math.Floor(Math.Log10(rough)));
        var normalized = rough / magnitude;
        var step = normalized switch
        {
            <= 1 => 1,
            <= 2 => 2,
            <= 5 => 5,
            _ => 10,
        };

        return Math.Max(1, (int)(step * magnitude));
    }

    // The chart formats tooltip values on its own and ignores the axis formatter, so a mood would read as "4" next to an emoji axis.
    string TooltipValue(SvgPath point) =>
        _options.YAxisToStringFunc is { } format && double.TryParse(point.LabelYValue, NumberStyles.Float, CultureInfo.CurrentCulture, out var value)
            ? format(value)
            : point.LabelYValue;

    static string MoodLabel(double value)
    {
        var i = (int)Math.Round(value) - 1;

        return i >= 0 && i < TrendChartPoint.ChartEmojis.Count ? TrendChartPoint.ChartEmojis[i] : string.Empty;
    }

    // Charts bake theme colors in at render time, so rebuild them when the theme changes (the System theme can flip mid-session).
    void OnThemeChanged(object sender, bool isDarkMode)
    {
        InvokeAsync(() =>
        {
            BuildChart();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        PreferenceService.ThemeChanged -= OnThemeChanged;
    }

    /// <summary>
    /// Returns a header to be shown above the view on the trends page.
    /// </summary>
    public static string GetHeaderText(DataPointCategory category)
    {
        var sb = new StringBuilder();
        // Show the name if there is one; otherwise the group title.
        if (string.IsNullOrEmpty(category.Name))
            sb.Append(category.Group);
        else
            sb.Append(category.Name);

        // Append the unit if it's a medication category with a unit.
        if (category.Type == PointType.Medication && !string.IsNullOrWhiteSpace(category.MedicationUnit))
        {
            sb.Append(' ').Append('(').Append(category.MedicationUnit?.Trim()).Append(')');
        }

        return sb.ToString();
    }

    string GetNoteLabel(DataPoint point, DateOnly day)
    {
        var sb = new StringBuilder();

        // The date the note was created if it's timestamped, otherwise the actual day assigned to the point.
        // If you just use the creation date you'll get the date the point was first created which could be anything depending on what the user does.
        sb.Append(point.IsTimestampedNote ? $"{point.CreatedAt:M/d/yy}" : $"{day:M/d/yy}");

        if (point.IsTimestampedNote)
        {
            // Add the time.
            sb.Append($" {point.CreatedAt.ToLocalTime():h:mm tt}");

            // Denote that it was created from a future date.
            if (DateOnly.FromDateTime(point.CreatedAt.Date) != point.Day.Date)
                sb.Append($" ({point.Day.Date:M/d/yy})");
        }

        return sb.ToString();
    }
}
